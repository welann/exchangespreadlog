CLICKHOUSE_URL=https://manyexchanges.zeabur.app/
CLICKHOUSE_DATABASE=zeabur
CLICKHOUSE_TABLE=bbo_ticks
CLICKHOUSE_CATALOG_TABLE=instrument_catalog
CLICKHOUSE_USERNAME=zeabur
CLICKHOUSE_PASSWORD=your-clickhouse-password
CLICKHOUSE_ACCEPT_INVALID_CERTS=true
CLICKHOUSE_CANDLE_MODE=auto
CLICKHOUSE_MAX_STALE_MS=120000

# Optional: let the frontend server read the collector config directly.
# Environment variables above still take precedence.
# CLICKHOUSE_CONFIG=../config.toml
